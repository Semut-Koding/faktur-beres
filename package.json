{
  "name": "faktur-beres",
  "version": "0.1.0",
  "private": true,
  "description": "Penjalan perintah Faktur Beres (npm run ...). Kode Python dikelola uv.",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "uv run python -m faktur_beres.devtools.setup",
    "services:up": "bash infra/scripts/services-up.sh",
    "services:down": "bash infra/scripts/services-down.sh",
    "services:status": "bash infra/scripts/services-status.sh",
    "services:logs": "bash infra/scripts/services-logs.sh",
    "odoo:init": "bash infra/scripts/odoo-init.sh",
    "odoo:seed": "uv run python -m faktur_beres.seed.load",
    "odoo:check": "uv run python -m faktur_beres.seed.check",
    "odoo:snapshot": "bash infra/scripts/odoo-snapshot.sh",
    "odoo:reset": "bash infra/scripts/odoo-reset.sh",
    "gen:faktur": "uv run python -m faktur_beres.generator tulis",
    "gen:periksa": "uv run python -m faktur_beres.generator periksa",
    "eval:orakel": "uv run python -m faktur_beres.evals.orakel",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "typecheck": "uv run mypy --strict",
    "test": "uv run python -m pytest",
    "test:integrasi": "bash infra/scripts/test-integrasi.sh",
    "check": "npm run lint && npm run typecheck && npm test",
    "guard:secrets": "uv run python -m faktur_beres.devtools.guard_secrets"
  }
}
