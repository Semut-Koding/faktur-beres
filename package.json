{
  "name": "faktur-beres",
  "version": "0.1.0",
  "private": true,
  "description": "Penjalan perintah Faktur Beres (npm run ...). Kode Python dikelola uv.",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "uv run python -m faktur_beres.devtools.setup",
    "services:up": "bash infra/scripts/services-up.sh",
    "services:down": "bash infra/scripts/services-down.sh",
    "services:status": "bash infra/scripts/services-status.sh",
    "services:logs": "bash infra/scripts/services-logs.sh",
    "odoo:init": "bash infra/scripts/odoo-init.sh",
    "odoo:seed": "uv run python -m faktur_beres.seed.load",
    "odoo:check": "uv run python -m faktur_beres.seed.check",
    "odoo:snapshot": "bash infra/scripts/odoo-snapshot.sh",
    "odoo:reset": "bash infra/scripts/odoo-reset.sh",
    "gen:faktur": "uv run python -m faktur_beres.generator tulis",
    "gen:ketahanan": "uv run python -m faktur_beres.generator ketahanan",
    "gen:periksa": "uv run python -m faktur_beres.generator periksa",
    "eval:orakel": "uv run python -m faktur_beres.evals.orakel",
    "eval:injeksi": "uv run python -m faktur_beres.evals.injeksi",
    "eval:graph": "uv run python -m faktur_beres.evals.graph",
    "eval:perencana": "uv run python -m faktur_beres.evals.perencana",
    "eval:ekstraksi": "uv run python -m faktur_beres.evals.ekstraksi",
    "llm:kuota": "uv run python -m faktur_beres.llm.usage",
    "llm:model": "uv run python -m faktur_beres.llm.models",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "typecheck": "uv run mypy --strict",
    "test": "uv run python -m pytest",
    "test:integrasi": "bash infra/scripts/test-integrasi.sh",
    "test:llm": "uv run python -m pytest -m llm -p no:cacheprovider",
    "check": "npm run lint && npm run typecheck && npm test",
    "agent:proses": "uv run python -m faktur_beres.graph.cli proses",
    "agent:status": "uv run python -m faktur_beres.graph.cli status",
    "agent:jejak": "uv run python -m faktur_beres.graph.cli jejak",
    "agent:putuskan": "uv run python -m faktur_beres.graph.cli putuskan",
    "agent:inbox": "uv run python -m faktur_beres.graph.cli inbox",
    "agent:ulang": "uv run python -m faktur_beres.graph.cli ulang",
    "graph:diagram": "uv run python -m faktur_beres.graph.diagram",
    "db:migrate": "uv run python -m faktur_beres.db migrasi",
    "db:reset": "uv run python -m faktur_beres.db reset",
    "guard:secrets": "uv run python -m faktur_beres.devtools.guard_secrets"
  }
}
