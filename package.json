{
  "name": "faktur-beres",
  "version": "0.1.0",
  "private": true,
  "description": "Penjalan perintah Faktur Beres (npm run ...). Kode Python dikelola uv.",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "uv run python -m faktur_beres.devtools.setup",
    "services:up": "bash infra/scripts/services-up.sh",
    "services:down": "bash infra/scripts/services-down.sh",
    "services:status": "bash infra/scripts/services-status.sh",
    "services:logs": "bash infra/scripts/services-logs.sh",
    "odoo:init": "bash infra/scripts/odoo-init.sh",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "test": "uv run python -m pytest",
    "check": "npm run lint && npm test",
    "guard:secrets": "uv run python -m faktur_beres.devtools.guard_secrets"
  }
}
