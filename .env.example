# Contoh variabel lingkungan Faktur Beres (M0).
# `npm run setup` menyalin berkas ini menjadi .env, lalu mengisi sandi yang kosong dengan nilai
# acak. Nilai yang sudah ada di .env tidak pernah ditimpa. .env tidak pernah di-commit.

# --- Odoo 19 (layanan odoo dan odoo-db di proyek compose fakturberes) ---
# Alamat Odoo dari host dan nama database.
ODOO_URL=http://127.0.0.1:28069
ODOO_DB=fakturberes
# Sandi superuser PostgreSQL milik Odoo (user `odoo`). Diisi acak oleh setup.
# Hanya dipakai saat volume odoo-db pertama kali dibuat; jangan diganti setelahnya.
ODOO_DB_PASSWORD=
# Sandi login web user `admin` Odoo. Diisi acak oleh setup, dipasang oleh `npm run odoo:init`.
ODOO_ADMIN_PASSWORD=
# API key JSON-2, ditulis oleh `npm run odoo:init` (berlaku 90 hari).
# Key admin hanya untuk skrip pengembang (init, seed, check, reset); key agent untuk kode agent.
ODOO_ADMIN_API_KEY=
ODOO_AGENT_API_KEY=

# --- Basis data aplikasi (PostgreSQL 18 + pgvector, layanan app-db) ---
# Sandi user `fakturberes`. Diisi acak oleh setup.
APP_DB_PASSWORD=
# URL untuk SQLAlchemy/psycopg 3. Bila kosong, setup menyusunnya dari APP_DB_PASSWORD.
APP_DB_URL=

# --- Mailpit (SMTP sandbox; email tidak pernah keluar dari laptop) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=21025
MAILPIT_URL=http://127.0.0.1:28025

# --- LLM (diisi sendiri oleh pemilik mulai M3) ---
GEMINI_API_KEY=
# Model per peran (ADR-0008): utama membaca dokumen dan menilai injeksi; kuat dipakai untuk
# pembacaan ulang BR-04. Di tier gratis keduanya Flash-Lite. Peran cadangan menjawab paling akhir,
# bila kedua peran itu tidak tersedia; kuotanya kecil (20 permintaan per hari, ADR-0010).
# `npm run llm:model` mencantumkan model yang tersedia; `npm run llm:model -- --uji` mengujinya.
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.6-flash
GEMINI_MODEL_EMBEDDING=gemini-embedding-2
# Batas permintaan per menit per model (lihat AI Studio). Bawaan aman: 5.
GEMINI_RPM_PRIMARY=5
GEMINI_RPM_STRONG=5
GEMINI_RPM_FALLBACK=4
GEMINI_RPM_EMBEDDING=80
# Batas waktu per permintaan: berisi dokumen di model utama dan kuat, berisi dokumen di model
# cadangan, dan tanpa dokumen (penilai injeksi, perencana, pemetaan baris) di semua model.
GEMINI_TIMEOUT_SECONDS=120
GEMINI_TIMEOUT_FALLBACK_SECONDS=180
GEMINI_TIMEOUT_TEXT_SECONDS=60
# Cache jawaban LLM (hanya bila diminta, mis. --pakai-cache), relatif ke akar repo.
LLM_CACHE_DIR=var/cache/llm
